config_version=5

[application]
config/name="Niangao P0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
EventBus="*res://scripts/core/event_bus.gd"
Config="*res://scripts/core/config_manager.gd"
Log="*res://scripts/core/log.gd"

[display]
window/size/viewport_width=360
window/size/viewport_height=420
window/size/window_width_override=360
window/size/window_height_override=420
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
